<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_card"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bom dia"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/preview_summary"
        android:padding="8dp"
        android:text="Hoje: 2 tarefas. Próximo: Médico 17:00"
        android:textColor="#FFE0A3"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:text="○  Levar o gato ao veterinário\n○  Pagar o MEI"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/preview_field"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="Escreva ou fale…"
            android:textColor="#D6DEE5"
            android:textSize="12sp" />
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/preview_mic_circle"
            android:padding="9dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>
</LinearLayout>
