<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6 a 11: backup automático no Google Drive (limite de 25 MB).
     Vão as figurinhas prontas; os dados de reedição (pesados) ficam para o backup em arquivo. -->
<full-backup-content>
    <exclude domain="file" path="edits" />
    <exclude domain="file" path="import_tmp" />
</full-backup-content>
